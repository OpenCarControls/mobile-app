# App configuration — copy to config.toml and fill in real values.
# config.toml is gitignored; this example is committed as the template.

[broker]
host     = "your-broker.example.com"
port     = 1883
username = "your_username"
password = "your_password"

[debug_server]
# HTTP server on the device used for debug/testing in place of BLE.
# Only active when the HTTP debug toggle is enabled inside the app (debug builds only).
host                = "192.168.1.1"
port                = 8080
polling_interval_ms = 500

